<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia" mc:Ignorable="d" x:DataType="vm:YearlyTrendsViewModel" x:Class="EventTracker.Views.YearlyTrendsView">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="Yearly Trends" FontWeight="Bold" FontSize="20" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:YearlyChartReport">
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,4" />
                                <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" Width="600" Height="320" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
