<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:EventTracker.Views;assembly=EventTracker" mc:Ignorable="d" x:DataType="vm:ClassicalViewModel" x:Class="EventTracker.Views.ClassicalView" xmlns:view="using:EventTracker.Views">
	<DockPanel>
		<TabControl>
			<TabItem Header="★">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Teal" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Composser}" Header="Composser" Width="*" />
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DaysAgoToStringConverter}}" Header="Ago" Width="70" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
			<TabItem Header="All">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Teal" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Composser}" Header="Composser" Width="*" />
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DaysAgoToStringConverter}}" Header="Ago" Width="70" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
		<TabControl Margin="5">
			<TabItem Header="Info">
				<ScrollViewer>
					<StackPanel>
						<TextBlock Text="{Binding SelectedItem.Composser}" FontSize="20" FontWeight="Bold" />
						<TextBlock Text="{Binding SelectedItem.Title}" />
						<Button>
							<Image Source="{Binding Image}" Width="430" Height="430" />
						</Button>
						<view:EventView DataContext="{Binding EventViewModel}" />
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding AddEventClick}">Add</Button>
							<TextBox Text="{Binding AddAmount}" />
							<TextBlock Text="{Binding AddAmountString}" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="New">
				<ScrollViewer>
					<StackPanel>
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding AddItemClick}" Margin="10">Add</Button>
							<TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="5">
							<TextBlock Text="Composser  " VerticalAlignment="Center"/>
							<TextBox Text="{Binding NewItem.Composser}" HorizontalAlignment="Stretch" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="5">
							<TextBlock Text="Title  " VerticalAlignment="Center"/>
							<TextBox Text="{Binding NewItem.Title}" HorizontalAlignment="Stretch" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="5">
							<TextBlock Text="Year  " VerticalAlignment="Center"/>
							<TextBox Text="{Binding NewItem.Year}" HorizontalAlignment="Stretch" />
							<TextBlock Text="   " VerticalAlignment="Center"/>
							<TextBlock Text="Runtime  " VerticalAlignment="Center"/>
							<TextBox Text="{Binding NewItem.Runtime}" HorizontalAlignment="Stretch" />
							<TextBlock Text="   " VerticalAlignment="Center"/>
							<TextBlock Text="ExternalID  " VerticalAlignment="Center"/>
							<TextBox Text="{Binding NewItem.ExternalID}" HorizontalAlignment="Stretch" />
						</StackPanel>
						<Button Command="{Binding OpenImage}" Margin="5">
							<Image Source="{Binding NewImage}" Width="430" Height="400" />
						</Button>
						<StackPanel Orientation="Horizontal" Margin="5">
							<CheckBox IsChecked="{Binding NewEvent.Bookmarked}">★</CheckBox>
							<TextBlock Text="   " VerticalAlignment="Center"/>
							<TextBlock Text="Rating " VerticalAlignment="Center"/>
							<NumericUpDown Value="{Binding NewEvent.Rating}" FormatString="0" Minimum="1" Maximum="5" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="5">
							<TextBox PlaceholderText="Comment" Text="{Binding NewEvent.Comment}" Width="250" Height="125" TextWrapping="Wrap"/>
							<TextBlock Text="   " VerticalAlignment="Center"/>
							<view:PeopleSelectionView DataContext="{Binding People}" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="5">
							<TextBlock Text="Platform " VerticalAlignment="Center"/>
							<ComboBox ItemsSource="{Binding PlatformTypes}" SelectedItem="{Binding NewEvent.Platform}" />
							<TextBlock Text="   " VerticalAlignment="Center"/>
							<CheckBox IsChecked="{Binding UseNewDate}" />
							<TextBox Text="{Binding NewDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}}" Width="200" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Edit">
				<TextBlock Text="Event" />
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
