<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:EventTracker.Views;assembly=EventTracker" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia" mc:Ignorable="d" x:DataType="vm:EventViewModel" x:Class="EventTracker.Views.EventView" xmlns:view="using:EventTracker.Views" x:CompileBindings="True">
	<Border Background="Teal" BorderBrush="Black" BorderThickness="2" CornerRadius="3" Padding="10" Margin="10">
		<TabControl>
			<TabItem Header="Event">
				<StackPanel Height="240">
					<ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Margin="0,0,0,10">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding DateEnd, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm}}" Width="130" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Rating		" />
						<TextBlock Text="{Binding SelectedEvent.Rating}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<CheckBox IsChecked="{Binding SelectedEvent.Bookmarked, Mode=TwoWay}">★</CheckBox>
						<TextBlock Text="		" />
						<CheckBox IsChecked="{Binding SelectedEvent.Completed, Mode=TwoWay}">Completed</CheckBox>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="People		" />
						<TextBlock Text="{Binding SelectedPersonString}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Platform	" VerticalAlignment="Center" />
						<TextBlock Text="{Binding SelectedPlatformType}" Width="100" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Amount	" VerticalAlignment="Center" />
						<TextBlock Text="{Binding SelectedEvent.Amount}" Width="100" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Comment	" VerticalAlignment="Top" />
						<TextBox Text="{Binding SelectedEvent.Comment}" IsReadOnly="True" TextWrapping="Wrap" Width="300" Height="65" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
					</StackPanel>
				</StackPanel>
			</TabItem>
			<TabItem Header="New">
				<StackPanel Height="240">
					<Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="1">
						<TextBlock Grid.Column="0" Text="Rating" VerticalAlignment="Center" Width="45"/>
						<NumericUpDown Grid.Column="1" Value="{Binding SelectedEvent.Rating}" FormatString="0" Minimum="1" Maximum="5" Width="60" />
						<Grid Grid.Column="3" ColumnDefinitions="Auto,160,34" Width="226">
							<CheckBox Grid.Column="0" IsChecked="{Binding IsEditDate}" ToolTip.Tip="Edit date and time" />
							<TextBox Grid.Column="1" Text="{Binding SelectedEventDateTimeText}" IsReadOnly="True" Width="160" />
							<Button x:Name="DateTimePickerButton" Grid.Column="2" Command="{Binding ToggleDateTimePicker}" ToolTip.Tip="Choose date and time" Width="34" Height="30">
								<TextBlock Text="📅︎" FontSize="14" />
							</Button>
							<Popup IsOpen="{Binding IsDateTimePickerOpen}" PlacementTarget="{Binding #DateTimePickerButton}" Placement="Bottom">
								<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="Gray" BorderThickness="1" Padding="10">
									<StackPanel Spacing="8">
										<DatePicker SelectedDate="{Binding PendingEventDate, Mode=TwoWay}" />
										<TimePicker SelectedTime="{Binding PendingEventTime, Mode=TwoWay}" />
										<Button Command="{Binding ConfirmDateTime}" HorizontalAlignment="Right">OK</Button>
									</StackPanel>
								</Border>
							</Popup>
						</Grid>
					</Grid>
					<StackPanel Orientation="Horizontal" Margin="1">
						<TextBlock Text="Chapter" VerticalAlignment="Center" Width="75" />
						<NumericUpDown Value="{Binding NewEventChapter}" FormatString="0" Minimum="1" Maximum="999" Width="100" />
						<TextBlock Text="		 " />
						<CheckBox IsChecked="{Binding SelectedEvent.Bookmarked, Mode=TwoWay}">★</CheckBox>
						<TextBlock Text="		 " />
						<CheckBox IsChecked="{Binding SelectedEvent.Completed, Mode=TwoWay}">Completed</CheckBox>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="1">
						<TextBlock Text="Platform" VerticalAlignment="Center" Width="75"/>
						<ComboBox ItemsSource="{Binding PlatformTypes}" SelectedItem="{Binding SelectedPlatformType, Mode=TwoWay}" Width="100" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="1">
						<TextBox PlaceholderText = "Comment" Text="{Binding SelectedEvent.Comment}" Width="210" Height="125" TextWrapping="Wrap"/>
						<TextBlock Text="		 " />
						<view:PeopleSelectionView DataContext="{Binding People}" />
					</StackPanel>
				</StackPanel>
			</TabItem>
			<TabItem Header="Stats">
				<StackPanel Height="240">
					<lvc:CartesianChart Series="{Binding Stats}" XAxes="{Binding StatsXAxes}" Width="425" Height="250"/>
				</StackPanel>
			</TabItem>
		</TabControl>
	</Border>
</UserControl>
