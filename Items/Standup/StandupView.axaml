<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:EventTracker.Views;assembly=EventTracker" mc:Ignorable="d" x:DataType="vm:StandupViewModel" x:Class="EventTracker.Views.StandupView" xmlns:view="using:EventTracker.Views">
	<DockPanel>
		<TabControl>
			<TabItem Header="Year">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Teal" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Performer}" Header="Performer" Width="150" />
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding Year}" Header="Year" Width="70" />
							<DataGridTextColumn Binding="{Binding Rating}" Header="Rating" Width="81" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
		<TabControl Margin="5">
			<TabItem Header="Info">
				<ScrollViewer>
					<StackPanel>
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding OpenLink}" ToolTip.Tip="{Binding OpenLinkToolTip}" Height="32" Margin="0,5">
								<TextBlock Text="Open ↗" />
							</Button>
							<Button Command="{Binding Search}" ToolTip.Tip="Search the web" Height="32" Margin="5">🔍</Button>
						</StackPanel>
						<Button>
							<Image Source="{Binding Image}" Width="315" Height="419" />
						</Button>
						<view:EventView DataContext="{Binding EventViewModel}" />
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding AddEventClick}">
								Add minutes
							</Button>
							<TextBox Text="{Binding AddAmount}" PlaceholderText="Pages" />
							<TextBlock Text="{Binding AddAmountString}" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="New">
				<Viewbox Classes="compact-new" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
					<StackPanel Spacing="12">
						<StackPanel>
							<TextBlock Text="New Item" FontWeight="Bold" Margin="0,0,0,8" />
							<StackPanel Orientation="Horizontal">
								<Button Command="{Binding AddItemClick}" Margin="15">
								Add
								</Button>
								<TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" Width="300" />
							</StackPanel>
							<view:ItemFieldsView DataContext="{Binding NewItemFields}" />
							<Button Command="{Binding OpenImage}" Margin="5">
								<Image Source="{Binding NewImage}" Width="240" Height="220" />
							</Button>
						</StackPanel>
						<StackPanel>
							<view:NewEventFieldsView />
						</StackPanel>
					</StackPanel>
				</Viewbox>
			</TabItem>
			<TabItem Header="Edit">
				<view:ItemEditView />
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
