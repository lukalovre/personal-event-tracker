<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:view="using:EventTracker.Views" x:Class="EventTracker.Views.ItemEditView" x:CompileBindings="False">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MinWidth="420" Spacing="6" Margin="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding UpdateItemClick}">Save</Button>
                <Button Command="{Binding ReplaceImage}">Replace image</Button>
                <Button Command="{Binding CropImage}">Edit image</Button>
                <Image Source="{Binding Image}" Width="56" Height="56" Stretch="Uniform" />
            </StackPanel>
            <view:ItemFieldsView DataContext="{Binding EditFields}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>