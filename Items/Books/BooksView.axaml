<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:EventTracker.Views;assembly=EventTracker" mc:Ignorable="d" x:DataType="vm:BooksViewModel" x:Class="EventTracker.Views.BooksView" xmlns:view="using:EventTracker.Views">
	<DockPanel>
		<TabControl>
			<TabItem Header="★">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Teal" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
							<DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="80" />
							<DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DaysAgoToStringConverter}}" Header="Ago" Width="70" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
			<TabItem Header="All">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Teal" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
							<DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
							<DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="70" />
							<DataGridTextColumn Binding="{Binding Rating}" Header="Rating" Width="81" />
							<DataGridCheckBoxColumn Binding="{Binding Completed}" Header="Completed" Width="55" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
			<TabItem Header="Authors">
				<DockPanel>
					<view:GridFilterView DataContext="{Binding GridFilterViewModel}" DockPanel.Dock="Top"/>
					<DataGrid Margin="1" Width="570" ItemsSource="{Binding BookAuthorList}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Teal" SelectedItem="{Binding SelectedGridItem}">
						<DataGrid.Columns>
							<DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="*" />
							<DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="100" />
							<DataGridTextColumn Binding="{Binding Books}" Header="Books" Width="80" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
		<TabControl Margin="5">
			<TabItem Header="Info">
				<ScrollViewer>
					<StackPanel>
						<TextBlock Text="{Binding SelectedItem.Title}" FontSize="20" FontWeight="Bold" />
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding OpenLink}" ToolTip.Tip="{Binding OpenLinkToolTip}" Height="32" Margin="0,5">
								<TextBlock Text="Open ↗" />
							</Button>
							<Button Command="{Binding Search}" ToolTip.Tip="Search the web" Height="32" Margin="5">🔍</Button>
						</StackPanel>
						<Button>
							<Image Source="{Binding Image}" Width="400" Height="400" />
						</Button>
						<view:EventView DataContext="{Binding EventViewModel}" />
						<StackPanel Orientation="Horizontal">
							<Button Command="{Binding AddEventClick}">
								Add pages
							</Button>
							<TextBox Text="{Binding AddAmount}" PlaceholderText="Pages" />
							<TextBlock Text="{Binding AddAmountString}" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="New">
				<Viewbox Classes="compact-new" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
					<StackPanel Spacing="12">
						<StackPanel>
							<TextBlock Text="New Item" FontWeight="Bold" Margin="0,0,0,8" />
							<StackPanel Orientation="Horizontal">
								<Button Command="{Binding AddItemClick}" Margin="15">
								Add
								</Button>
								<TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" Width="300" />
							</StackPanel>
							<StackPanel Orientation="Horizontal">
								<TextBox PlaceholderText="Author" Text="{Binding NewItem.Author}" HorizontalAlignment="Stretch" />
								<TextBox PlaceholderText="Title" Text="{Binding NewItem.Title}" HorizontalAlignment="Stretch" />
							</StackPanel>
							<TextBox PlaceholderText="Year" Text="{Binding NewItem.Year}" Width="70"/>
							<TextBox PlaceholderText="GoodreadsID" Text="{Binding NewItem.ExternalID}" Width="150" />
							<CheckBox IsChecked="{Binding NewItem.is1001}">
							1001
							</CheckBox>
							<Button Command="{Binding OpenImage}" Margin="5">
								<Image Source="{Binding NewImage}" Width="240" Height="220" />
							</Button>
						</StackPanel>
						<StackPanel>
							<view:NewEventFieldsView />
						</StackPanel>
					</StackPanel>
				</Viewbox>
			</TabItem>
			<TabItem Header="Edit">
				<view:ItemEditView />
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
