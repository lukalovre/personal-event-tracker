<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:DataType="vm:ItemCategoriesSettingsViewModel" x:Class="EventTracker.Views.ItemCategoriesSettingsView">
    <Grid ColumnDefinitions="220,*" Margin="16">
        <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8" Margin="0,0,16,0">
            <TextBlock Text="Item Categories" FontSize="20" FontWeight="Bold" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemCategorySettingsEditor">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SelectedCategory.Name}" FontSize="20" FontWeight="Bold" />
                <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="New item amount override" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCategory.Settings.NewItemAmountOverride}" />
                    <TextBlock Grid.Row="1" Text="Default new item chapter" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCategory.Settings.DefaultNewItemChapter}" />
                    <TextBlock Grid.Row="2" Text="Default new item rating" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCategory.Settings.DefaultNewItemRating}" />
                    <TextBlock Grid.Row="3" Text="Default add amount" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCategory.Settings.DefaultAddAmount}" />
                    <TextBlock Grid.Row="4" Text="Default new item platform" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCategory.Settings.DefaultNewItemPlatform}" />
                    <TextBlock Grid.Row="5" Text="Amount verb" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCategory.Settings.AmountVerb}" />
                    <TextBlock Grid.Row="6" Text="Date filter" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding DateTimeFilterOptions}" SelectedItem="{Binding SelectedCategory.DateTimeFilter}" />
                    <TextBlock Grid.Row="7" Text="Amount to minutes modifier" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedCategory.Settings.AmountToMinutesModifier}" />
                    <TextBlock Grid.Row="8" Text="Amount type" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding AmountTypes}" SelectedItem="{Binding SelectedCategory.Settings.AmountType}" />
                    <TextBlock Grid.Row="9" Text="Default new item completed" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding SelectedCategory.Settings.DefaultNewItemCompleted}" />
                    <TextBlock Grid.Row="10" Text="Default new item bookmarked" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding SelectedCategory.Settings.DefaultNewItemBookmarked}" />
                    <TextBlock Grid.Row="11" Text="Use full amount by default" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding SelectedCategory.Settings.IsFullAmountDefaultValue}" />
                </Grid>
                <CheckBox Content="Show year filter" IsChecked="{Binding SelectedCategory.Settings.ShowYearFilter}" />
                <Button Content="Save" Command="{Binding Save}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>