<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EventTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:DataType="vm:YearlyTrendsSettingsViewModel" x:Class="EventTracker.Views.YearlyTrendsSettingsView">
    <Border Padding="20" Margin="10" BorderBrush="Gray" BorderThickness="1">
        <StackPanel Width="520">
            <TextBlock Text="Yearly Trends" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Choose which category charts are shown and set their order." Margin="0,4,0,14" />
            <Button Content="Save" Command="{Binding Save}" HorizontalAlignment="Left" Margin="0,0,0,14" />
            <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}">
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:YearlyTrendsCategorySetting">
                        <Border Padding="6" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Up" Command="{Binding #CategoryList.DataContext.MoveUp}" CommandParameter="{Binding}" Margin="4,0" />
                                <Button Grid.Column="3" Content="Down" Command="{Binding #CategoryList.DataContext.MoveDown}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
